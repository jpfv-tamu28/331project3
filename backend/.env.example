# Copy to .env and fill in. .env is git-ignored; never commit real credentials.
DB_HOST=csce-315-db.engr.tamu.edu
DB_PORT=5432
DB_NAME=squad_55_db
DB_USER=squad_55
DB_PASSWORD=
# The TAMU server requires SSL; set to false only for a local database without SSL.
DB_SSL=true

PORT=3001
# Browser origins allowed to call the API (comma-separated). Only needed when the
# frontend is served from a different domain than the API.
CORS_ORIGIN=http://localhost:5173
