# Copy to .env and fill in. .env is git-ignored; never commit real credentials.
DB_HOST=csce-315-db.engr.tamu.edu
DB_PORT=5432
DB_NAME=squad_55_db
DB_USER=squad_55
DB_PASSWORD=
# The TAMU server requires SSL; set to false only for a local database without SSL.
DB_SSL=true

PORT=3001
# Browser origins allowed to call the API (comma-separated). Only needed when the
# frontend is served from a different domain than the API.
CORS_ORIGIN=http://localhost:5173

# Google OAuth 2.0 credentials (from Google Cloud Console -> APIs & Services -> Credentials).
# Authorized redirect URI for local dev: http://localhost:5173/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional override; defaults to <request-origin>/api/auth/google/callback
GOOGLE_CALLBACK_URL=
# Secret used to sign session and OAuth state cookies (generate any random string for production)
SESSION_SECRET=change-me-in-production
# Zip code whose current weather the kiosk settings panel shows.
WEATHER_ZIP=77840
# Bypass google login
DEV_AUTH_BYPASS=false