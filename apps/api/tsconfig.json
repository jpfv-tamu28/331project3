{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "rootDir": "./src",
    "outDir": "./dist",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@boba/database": ["../../packages/database/src/index.ts"],
      "@boba/lib": ["../../packages/lib/src/types.ts"]
    }
  },
  "include": ["src/**/*"]
}